# Defaults to the local mock provider, so no API key is needed to boot the test stack.
LLM_PROVIDER=mock
LOG_LEVEL=DEBUG
VITE_API_URL=http://localhost:18000

# Set LLM_PROVIDER=groq and provide GROQ_API_KEY to test against Groq.
GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Optional providers if you switch LLM_PROVIDER.
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-2.5-flash-preview
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini

TEST_POSTGRES_USER=jobcopilot_test
TEST_POSTGRES_PASSWORD=jobcopilot_test
TEST_POSTGRES_DB=jobcopilot_test
LOGFIRE_TOKEN=
