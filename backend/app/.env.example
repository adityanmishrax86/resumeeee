DATABASE_URL=postgresql+psycopg://postgres:xxxx@localhost:5432/mydb
LOG_LEVEL = 'DEBUG'

# LLM provider selection: 'mock', 'google', 'openai', 'groq', or 'ollama'
LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_LLM_MODEL=gemini-3-flash-preview
LOGFIRE_TOKEN=hello

# OpenAI
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4o-mini

# Groq
# GROQ_API_KEY=
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Ollama (local/self-hosted — no API key needed for local)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_LLM_MODEL=llama3
# OLLAMA_API_KEY=              # Only needed for Ollama Cloud
# OLLAMA_TIMEOUT=300           # Seconds; local models can be slower

# NVIDIA NIM API key (set this in production/dev before using the NIM client)
# NVIDIA_API_KEY=

# Optional: model and invoke URL for NVIDIA NIM
# NIM_MODEL=google/gemma-4-31b-it
# NIM_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions