{
  "manifest_version": 3,
  "name": "Job Extractor",
  "short_name": "JobExtract",
  "description": "Extracts job details as JSON from LinkedIn and Naukri job pages.",
  "version": "1.3.2",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "tabs"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Job Extractor",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}