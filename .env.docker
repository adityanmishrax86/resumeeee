# ==============================================================================
# Environment Configuration for Docker Compose
# Copy this file to .env or pass it explicitly to docker compose:
# `docker compose --env-file .env.docker up`
# ==============================================================================

# LLM Provider selection: 'mock', 'google', 'openai', 'groq', or 'ollama'
LLM_PROVIDER=google
LOG_LEVEL=INFO

# Google Gemini Credentials (required if LLM_PROVIDER=google)
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_LLM_MODEL=gemini-2.5-flash-preview

# OpenAI Credentials (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_LLM_MODEL=gpt-4o-mini

# Groq Credentials (if LLM_PROVIDER=groq)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Ollama Settings (if using the local ollama profile / service)
OLLAMA_BASE_URL=http://ollama:11434/v1
# OLLAMA_LLM_MODEL=llama3

# Frontend variables (called by the user's browser, so keep localhost)
VITE_API_URL=http://localhost:8000

# Observability
LOGFIRE_TOKEN=
